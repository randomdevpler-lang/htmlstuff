<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>IXL - Math Education</title>
    <style>
        /* Base Styling */
        :root {
            --bg-dark: #0f0f0f;
            --sidebar-bg: #181818;
            --chat-bg: #1e1e1e;
            --accent-blue: #3cff00;
            --text-main: #e0e0e0;
            --code-bg: #2d2d2d;
            --border: #333333;
        }

        body {
            font-family: 'Consolas', 'Monaco', 'Courier New', monospace;
            background-color: var(--bg-dark);
            color: var(--text-main);
            margin: 0;
            display: flex;
            flex-direction: column;
            height: 100vh;
        }

        /* Header */
        header {
            background-color: var(--sidebar-bg);
            padding: 15px 25px;
            border-bottom: 1px solid var(--border);
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .logo {
            color: var(--accent-blue);
            font-weight: bold;
            font-size: 1.4rem;
            letter-spacing: 1px;
        }

        /* Chat Area */
        #chat-window {
            flex-grow: 1;
            overflow-y: auto;
            padding: 20px;
            display: flex;
            flex-direction: column;
            gap: 20px;
        }

        .msg-row {
            display: flex;
            width: 100%;
        }

        .user-row { justify-content: flex-end; }
        .bot-row { justify-content: flex-start; }

        .message {
            max-width: 85%;
            padding: 15px;
            border-radius: 5px;
            line-height: 1.6;
            white-space: pre-wrap;
            word-wrap: break-word;
        }

        .user-message {
            background-color: var(--accent-blue);
            color: white;
            border-bottom-right-radius: 0;
        }

        .bot-message {
            background-color: var(--chat-bg);
            border: 1px solid var(--border);
            border-bottom-left-radius: 0;
        }

        /* Input Area */
        #input-area {
            background-color: var(--sidebar-bg);
            padding: 25px;
            border-top: 1px solid var(--border);
            display: flex;
            gap: 15px;
        }

        #user-input {
            flex-grow: 1;
            background-color: var(--code-bg);
            border: 1px solid var(--border);
            color: white;
            padding: 12px;
            border-radius: 4px;
            outline: none;
            font-family: inherit;
        }

        #user-input:focus {
            border-color: var(--accent-blue);
        }

        button {
            background-color: var(--accent-blue);
            color: white;
            border: none;
            padding: 0 25px;
            border-radius: 4px;
            cursor: pointer;
            font-weight: bold;
            transition: opacity 0.2s;
        }

        button:hover {
            opacity: 0.8;
        }

        button:disabled {
            background-color: #555;
            cursor: not-allowed;
        }
    </style>
</head>
<body>

    <header>
        <div class="logo">CodeGPT //_</div>
        <div style="font-size: 0.8rem; opacity: 0.6;">JS • HTML • CSS • AI</div>
    </header>

    <div id="chat-window">
        <div class="msg-row bot-row">
            <div class="message bot-message">System: CodeGPT is online. I am optimized for coding with high flexibility. How can I help you script today?</div>
        </div>
    </div>

    <div id="input-area">
        <input type="text" id="user-input" placeholder="Prompt here." autocomplete="off">
        <button id="send-btn">SEND</button>
    </div>

<script>
    const chatWindow = document.getElementById('chat-window');
    const userInput = document.getElementById('user-input');
    const sendBtn = document.getElementById('send-btn');

    // CONFIGURATION
// Change v1beta to v1 and use the newer 2.5 model
const API_KEY = 'AIzaSyAlMchhou2zFmPtWrwvlFjgD7T75uIraJU';
const MODEL = "gemini-2.5-flash"; 
const API_URL = `https://generativelanguage.googleapis.com/v1/models/${MODEL}:generateContent?key=${API_KEY}`;

    function appendMessage(role, text) {
        const row = document.createElement('div');
        row.className = `msg-row ${role}-row`;
        
        const msg = document.createElement('div');
        msg.className = `message ${role}-message`;
        msg.textContent = text;
        
        row.appendChild(msg);
        chatWindow.appendChild(row);
        chatWindow.scrollTop = chatWindow.scrollHeight;
        return msg;
    }

    async function handleChat() {
        const prompt = userInput.value.trim();
        if (!prompt) return;

        appendMessage('user', prompt);
        userInput.value = '';
        sendBtn.disabled = true;

        const loadingMsg = appendMessage('bot', 'Connecting to Code-Core...');

        try {
            const response = await fetch(`https://generativelanguage.googleapis.com/v1beta/models/${MODEL}:generateContent?key=${API_KEY}`, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({
                    contents: [{
                        parts: [{ 
                            text: `You are CodeGPT. Answer as a senior software engineer. Focus on JS, HTML, and CSS. Task: ${prompt}` 
                        }]
                    }]
                })
            });

            const data = await response.json();

            // LOGGING: Right-click your browser -> Inspect -> Console to see this
            console.log("API Response:", data);

            if (data.error) {
                loadingMsg.textContent = `API Error: ${data.error.message}`;
            } else if (data.candidates && data.candidates[0].content) {
                loadingMsg.textContent = data.candidates[0].content.parts[0].text;
            } else {
                // This usually means safety filters blocked the response
                loadingMsg.textContent = "The AI refused to answer this prompt. Try rephrasing your coding request.";
            }

        } catch (error) {
            loadingMsg.textContent = "Network Error: Check your internet or API key status.";
            console.error("Fatal Error:", error);
        } finally {
            sendBtn.disabled = false;
        }
    }

    sendBtn.addEventListener('click', handleChat);
    userInput.addEventListener('keypress', (e) => { if (e.key === 'Enter') handleChat(); });
</script>
</body>
</html>
